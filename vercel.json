{
  "version": 2,
  "builds": [
    {
      "src": "api/hugoexpressapi.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/generate",
      "destination": "/api/hugoexpressapi?path=generate"
    },
    {
      "source": "/01/:upc/21/:hugoHash",
      "destination": "/api/hugoexpressapi"
    }
  ]
}

